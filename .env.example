# ==========================================
# RUANG DIGITAL — ENVIRONMENT CONFIGURATION
# ==========================================

# 1. DATABASE (Neon PostgreSQL)
# Pooled connection string (for queries)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/ruang_digital?sslmode=require&pgbouncer=true"
# Direct connection string (for migrations)
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/ruang_digital?sslmode=require"

# 2. AUTHENTICATION & SECURITY
AUTH_SECRET="your-super-secret-jwt-key-min-32-chars-long"
SESSION_COOKIE_NAME="rd_session"

# 3. PAYMENT (Midtrans)
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxxxxxxxxxxxxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxxxxxxxxxxxx"
MIDTRANS_IS_PRODUCTION="false"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxxxxxxxxxxxx"

# 4. STORAGE & DIGITAL DELIVERY (Google Apps Script + Google Drive)
GOOGLE_APPS_SCRIPT_URL="https://script.google.com/macros/s/AKfycbx.../exec"
GOOGLE_APPS_SCRIPT_SECRET="your-gas-hmac-shared-secret-token"

# 5. APPLICATION URLS
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"
